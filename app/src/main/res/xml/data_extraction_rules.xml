<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Only the store's own files travel: library, history, settings and the
     player choices. WebView's data (app_webview_*, app_textures, shared_prefs, cache) never does, so a
     restored phone starts with a fresh identity like any launch. The channel and feed caches refill. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
        <include domain="file" path="history.json" />
        <include domain="file" path="settings.json" />
        <include domain="file" path="player.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
        <include domain="file" path="history.json" />
        <include domain="file" path="settings.json" />
        <include domain="file" path="player.json" />
    </device-transfer>
</data-extraction-rules>
